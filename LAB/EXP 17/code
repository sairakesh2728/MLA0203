from sklearn.linear_model import LinearRegression

X = [
    [2, 32],
    [4, 64],
    [6, 128],
    [8, 128],
    [12, 256]
]

y = [8000, 12000, 18000, 22000, 30000]

model = LinearRegression()
model.fit(X, y)

prediction = model.predict([[8, 256]])

print("Predicted Mobile Price:", round(prediction[0], 2))
